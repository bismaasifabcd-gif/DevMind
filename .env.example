# DevMind Environment Configuration

# Required: Groq API Key for AI inference
GROQ_API_KEY=your_groq_api_key_here

# Optional: Secondary Groq API key for rate limiting
GROQ_API_KEY_2=your_secondary_groq_api_key

# Optional: GitHub token for PR creation and repository access
GITHUB_TOKEN=your_github_token_here

# Optional: OpenAI API key as fallback
OPENAI_API_KEY=your_openai_api_key

# Optional: MLflow tracking configuration
MLFLOW_TRACKING_URI=http://localhost:5000

# Optional: Phoenix tracing configuration
PHOENIX_HOST=localhost
PHOENIX_PORT=6006